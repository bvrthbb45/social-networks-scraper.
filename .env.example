# Copy to .env and fill in. NEVER commit .env. Generate secrets with the commands shown.
POSTGRES_DB=opsec
POSTGRES_USER=opsec
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://opsec:change-me@db:5432/opsec

# development | test | production
ENVIRONMENT=development

# AES-256-GCM key for encrypted columns:  openssl rand -base64 32
# Losing this key makes encrypted data unrecoverable: back it up separately from the database.
FIELD_ENCRYPTION_KEY=
# HMAC key for blind indexes (lookups of encrypted values):  openssl rand -base64 32
BLIND_INDEX_KEY=
# JWT signing secret (>= 32 chars):  openssl rand -base64 48
JWT_SECRET=

# How long collected public content is kept before automatic deletion.
RETENTION_DAYS=90

# Sessions / sign-in
ACCESS_TOKEN_MINUTES=10
SESSION_MAX_HOURS_WEB=12
SESSION_MAX_HOURS_NATIVE=168
INVITE_HOURS=72
# Browser origins allowed to call the API (comma separated, no wildcard)
ALLOWED_ORIGINS=
# Key rotation: set FIELD_ENCRYPTION_KEY_ID to the new id and list previous keys as "1:<base64>,2:<base64>"
FIELD_ENCRYPTION_KEY_ID=1
FIELD_ENCRYPTION_OLD_KEYS=

# Encrypted media files (mount a volume; never inside the repo) and optional trained-model folder
MEDIA_DIR=/data/media
MODEL_DIR=

# ---- Deployment (docker compose) ----
# Production: secure cookies, HSTS. The refresh cookie is only sent to the auth endpoints behind the /api prefix.
# ENVIRONMENT=production
# REFRESH_COOKIE_PATH=/api/auth
# Folder with the unit's TLS certificate (fullchain.pem, privkey.pem). Never commit it.
# CERT_DIR=/etc/opsec/certs
# HTTP_PORT=80
# HTTPS_PORT=443
